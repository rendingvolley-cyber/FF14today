{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ff14-today",
  "main": "src/gc-top3-entry.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ff14-today",
